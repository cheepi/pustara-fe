# Firebase Client SDK (dari Firebase Console > Project Settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Google Books API (optional)
NEXT_PUBLIC_GOOGLE_BOOKS_API_KEY=your_google_books_key_here

# Turnstile CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Setup Instructions:
# 1. Rename this file to .env.local (or .env)
# 2. Fill in the values from Firebase Console
# 3. Never commit .env.local to git (it's in .gitignore)
